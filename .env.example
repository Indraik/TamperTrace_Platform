# Flask
FLASK_SECRET_KEY=your-secret-key-here-for-flask-sessions

# VirusTotal Threat Intelligence API
VT_API_KEY=your_virustotal_api_key_here

# SMTP Alerting (Gmail App Password)
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# WhatsApp Alerting (Twilio)
TWILIO_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
ADMIN_WHATSAPP=+1234567890

# Disaster Recovery (Target Website Repository Path)
TARGET_SITE_ROOT=D:\Projects\target_site_repo
TARGET_BASE_URL=http://127.0.0.1:5002

# Authenticated Scanning (Optional: for protected routes like /admin_dashboard)
AUTH_ENABLED=false
AUTH_LOGIN_URL=http://127.0.0.1:5002/login
AUTH_USERNAME=admin@example.com
AUTH_PASSWORD=change_me

# Optional CSS Selectors (leave empty to use intelligent auto-detection)
AUTH_USERNAME_SELECTOR=
AUTH_PASSWORD_SELECTOR=
AUTH_SUBMIT_SELECTOR=

# Monitoring Thresholds
DOM_STABLE_SECONDS=3.0
NETWORK_IDLE_SECONDS=1.5
PAGE_LOAD_TIMEOUT=25
SCAN_INTERVAL_SECONDS=35
VISUAL_DIFF_THRESHOLD=8.0
